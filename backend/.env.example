# ==============================================================================
# 🌌 RUEXIS AI Platform — Backend Environment Configuration Template
# Copy this file to .env and fill in your API keys before starting the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 Security & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here

# ------------------------------------------------------------------------------
# 🤖 Primary LLM Providers (Chat & ReACT Conversational Agents)
# ------------------------------------------------------------------------------
# Groq API Key (Free tier LPU fast inference - https://console.groq.com/)
# Supports: Qwen 3.8 27B, GPT-OSS 120B, Llama 3.3 70B
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Free community & multi-model router - https://openrouter.ai/)
# Supports: Gemini 2.5 Flash, DeepSeek R1, Llama 3.3
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 🔬 Document Extraction & Dual Code Synthesis Engines
# ------------------------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com/)
# Used for: Complex PDF OCR/extraction & Dual Code Engine B (Math + Deep Context)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Access Token (https://huggingface.co/settings/tokens)
# Used for: Dual Code Engine A (Qwen/Qwen2.5-Coder-32B-Instruct)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Extraction Provider: 'gemini' (default) or 'openrouter'
EXTRACTION_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 🔍 Academic Search & Knowledge Retrieval Tools
# ------------------------------------------------------------------------------
# Tavily Search API Key (Free tier - https://tavily.com/)
# Used for: Google Scholar & live academic research grounding
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Access Token (Optional, to avoid rate limits when searching repositories)
GITHUB_TOKEN=your_github_token_here

# ------------------------------------------------------------------------------
# 🏠 Local / Offline Services (Optional)
# ------------------------------------------------------------------------------
# Local Ollama instance for 100% offline inference (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Local GROBID instance for scholarly PDF metadata extraction (optional)
# Docker: docker run -p 8070:8070 grobid/grobid:0.9.0-crf
GROBID_URL=http://localhost:8070

# ------------------------------------------------------------------------------
# 📊 User Registry & Telemetry (Optional)
# ------------------------------------------------------------------------------
# Google Sheets Webhook URL to sync registered users
USER_REGISTRY_WEBHOOK=your_google_sheets_webhook_url_here
