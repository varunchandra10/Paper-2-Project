# Tavily Search API Key (Get a free key from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub Access Token (Optional, to avoid GitHub API rate limits)
GITHUB_TOKEN=your_github_token_here

# Google Sheets Webhook Registry (Optional, to sync registered users to Google Sheet)
USER_REGISTRY_WEBHOOK=your_google_sheets_webhook_url_here
